# Copy this file to `.env` and fill in the value. `.env` is git-ignored.
# Never commit a real key, and never paste a key into a .py file.
#
#   copy .env.example .env
#
# If this variable is missing at runtime, the app reports it by name and stops.
# The value itself is never logged, printed, or included in an error message.

GROQ_API_KEY=
